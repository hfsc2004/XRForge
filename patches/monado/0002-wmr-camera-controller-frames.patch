 };
@@ -423,9 +427,34 @@ img_xfer_cb(struct libusb_transfer *xfer)
 			xrt_sink_push_frame(cam->cam_sinks[i], frames[i]);
 		}
 
+		if (debug_get_bool_option_wmr_controller_use_slam_frames()) {
+			for (int i = 0; i < cam->slam_cam_count; i++) {
+				if (cam->controller_cam_sinks[i] != NULL) {
+					xrt_sink_push_frame(cam->controller_cam_sinks[i], frames[i]);
+				}
+			}
+		}
+
 		for (int i = 0; i < cam->slam_cam_count; i++) {
 			xrt_frame_reference(&frames[i], NULL);
 		}
+	} else {
+		DRV_TRACE_IDENT(push_controller_to_sinks);
+
+		struct xrt_frame *frames[WMR_MAX_CAMERAS] = {NULL};
+		for (int i = 0; i < cam->tcam_count; i++) {
+			u_frame_create_roi(xf, cam->tcam_confs[i].roi, &frames[i]);
+		}
+
+		for (int i = 0; i < cam->tcam_count; i++) {
+			if (cam->controller_cam_sinks[i] != NULL) {
+				xrt_sink_push_frame(cam->controller_cam_sinks[i], frames[i]);
+			}
+		}
+
+		for (int i = 0; i < cam->tcam_count; i++) {
+			xrt_frame_reference(&frames[i], NULL);
+		}
 	}
 
 drop_frame:
