+static void
+wmr_controller_blob_debug_push(struct t_blob_sink *sink, struct t_blob_observation *observation)
+{
+	struct wmr_controller_blob_debug_sink *debug_sink =
+	    container_of(sink, struct wmr_controller_blob_debug_sink, base);
+
+	debug_sink->observation_count++;
+	if (debug_sink->observation_count == 1 || debug_sink->observation_count % 180 == 0 ||
+	    observation->num_blobs != debug_sink->last_blob_count) {
+		WMR_INFO(debug_sink->wh, "controller cam%u blobs #%" PRIu64 ": %u", debug_sink->camera_index,
+		         debug_sink->observation_count, observation->num_blobs);
+	}
+	debug_sink->last_blob_count = observation->num_blobs;
+
+	t_blob_sink_push_blobs(debug_sink->downstream, observation);
+}
+
+static void
+wmr_controller_blob_debug_destroy(struct t_blob_sink *sink)
+{
+	(void)sink;
+}
