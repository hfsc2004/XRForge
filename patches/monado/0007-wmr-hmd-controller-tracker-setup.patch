+void
+wmr_fallback_update_hmd_position(const struct xrt_space_relation *relation)
+{
+	if ((relation->relation_flags & XRT_SPACE_RELATION_POSITION_VALID_BIT) == 0) {
+		return;
+	}
+
+	fallback_hmd_position = relation->pose.position;
+	fallback_hmd_position_valid = true;
+}
+
+bool
+wmr_fallback_get_hmd_position(struct xrt_vec3 *out_position)
+{
+	if (!fallback_hmd_position_valid) {
+		return false;
+	}
+
+	*out_position = fallback_hmd_position;
+	return true;
+}
