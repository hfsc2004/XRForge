+static bool
+wmr_hmd_setup_controller_tracking(struct wmr_hmd *wh, struct xrt_slam_sinks *out_sinks)
+{
+	if (!debug_get_bool_option_wmr_controller_tracking()) {
+		return false;
+	}
+
+	if (wh->config.tcam_count <= 0) {
+		WMR_WARN(wh, "WMR controller tracking disabled: no tracking cameras");
+		return false;
+	}
+
+	wh->tracking.controller_tracking_source.get_tracked_pose = wmr_hmd_constellation_get_tracked_pose;
+
+	struct t_constellation_tracker_params tracker_params = {0};
+	tracker_params.num_mosaics = 1;
+	struct t_constellation_tracker_camera_mosaic *mosaic = &tracker_params.mosaics[0];
+	mosaic->tracking_origin = &wh->tracking.controller_tracking_source;
+	mosaic->num_cameras = (size_t)wh->config.tcam_count;
+
+	for (int i = 0; i < wh->config.tcam_count; i++) {
+		mosaic->cameras[i].calibration = wmr_hmd_get_cam_calib(wh, i);
+		mosaic->cameras[i].pose_in_origin = wh->config.tcams[i]->pose;
+		mosaic->cameras[i].has_concrete_pose = true;
+	}
+
+	int ret = t_constellation_tracker_create(&wh->tracking.xfctx, &tracker_params, &wh->tracking.controller_tracker);
+	if (ret != 0 || wh->tracking.controller_tracker == NULL) {
+		WMR_WARN(wh, "Unable to setup WMR controller constellation tracker");
+		return false;
+	}
+
+	struct xrt_slam_sinks controller_sinks = {0};
+	controller_sinks.cam_count = wh->config.tcam_count;
+
+	for (int i = 0; i < wh->config.tcam_count; i++) {
+		struct t_blob_sink *blob_sink = mosaic->cameras[i].blob_sink;
+		struct wmr_controller_blob_debug_sink *debug_sink = &wh->tracking.controller_blob_debug_sinks[i];
+		struct xrt_frame_sink *frame_sink = NULL;
+
+		debug_sink->base.push_blobs = wmr_controller_blob_debug_push;
+		debug_sink->base.destroy = wmr_controller_blob_debug_destroy;
+		debug_sink->downstream = blob_sink;
+		debug_sink->wh = wh;
+		debug_sink->camera_index = (uint32_t)i;
+		debug_sink->observation_count = 0;
+		debug_sink->last_blob_count = 0;
+		blob_sink = &debug_sink->base;
+
+		struct t_rift_blobwatch_params blobwatch_params = {
+		    .pixel_threshold = (uint8_t)debug_get_num_option_wmr_controller_blob_pixel_threshold(),
+		    .blob_required_threshold = (uint8_t)debug_get_num_option_wmr_controller_blob_required_threshold(),
+		    .max_match_dist = RIFT_BLOBWATCH_DEFAULT_MAX_MATCH_DIST,
+		    .max_blob_width = (uint16_t)debug_get_num_option_wmr_controller_blob_max_width(),
+		    .allow_single_pixel_blobs = debug_get_bool_option_wmr_controller_blob_allow_single_pixel(),
+		};
+
+		ret = t_rift_blobwatch_create(&blobwatch_params, &wh->tracking.xfctx, blob_sink, &frame_sink,
+		                              &wh->tracking.controller_blobwatches[i]);
+		if (ret != 0 || frame_sink == NULL) {
+			WMR_WARN(wh, "Unable to setup WMR controller blobwatch for camera %d", i);
+			return false;
+		}
+
+		u_sink_create_format_converter(&wh->tracking.xfctx, XRT_FORMAT_L8, frame_sink, &frame_sink);
+		if (!u_sink_simple_queue_create(&wh->tracking.xfctx, frame_sink, &frame_sink)) {
+			WMR_WARN(wh, "Unable to setup WMR controller blobwatch queue for camera %d", i);
+			return false;
+		}
+
+		controller_sinks.cams[i] = frame_sink;
+	}
+
+	wh->tracking.controller_tracking_enabled = true;
+	wh->base.tracking_origin = t_constellation_tracker_get_tracking_origin(wh->tracking.controller_tracker);
+	wh->tracking.controller_sinks = controller_sinks;
+	*out_sinks = controller_sinks;
+
+	WMR_INFO(wh, "WMR optical controller tracking initialized with %d cameras", wh->config.tcam_count);
+	return true;
+}
