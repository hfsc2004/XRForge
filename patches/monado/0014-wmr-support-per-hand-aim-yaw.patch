+static float
+wmr_controller_get_aim_yaw_degrees(struct xrt_device *xdev)
+{
+	const char *env = xdev->device_type == XRT_DEVICE_TYPE_LEFT_HAND_CONTROLLER
+	                      ? getenv("WMR_CONTROLLER_AIM_YAW_DEGREES_LEFT")
+	                      : getenv("WMR_CONTROLLER_AIM_YAW_DEGREES_RIGHT");
+
+	if (env != NULL && env[0] != '\0') {
+		char *end = NULL;
+		float value = strtof(env, &end);
+		if (end != env) {
+			return value;
+		}
+	}
+
+	return debug_get_float_option_wmr_controller_aim_yaw_degrees();
+}
 
