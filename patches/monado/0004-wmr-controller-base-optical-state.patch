+struct wmr_controller_base *
+wmr_controller_base_from_xrt_device(struct xrt_device *xdev)
+{
+	if (xdev == NULL) {
+		return NULL;
+	}
+
+	if (xdev->device_type != XRT_DEVICE_TYPE_LEFT_HAND_CONTROLLER &&
+	    xdev->device_type != XRT_DEVICE_TYPE_RIGHT_HAND_CONTROLLER) {
+		return NULL;
+	}
+
+	if (xdev->name != XRT_DEVICE_WMR_CONTROLLER) {
+		return NULL;
+	}
+
+	return wmr_controller_base(xdev);
+}
