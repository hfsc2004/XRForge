+}
+
+static inline struct wmr_controller_base *
+wmr_controller_base_from_constellation_tracking_source(struct t_constellation_tracker_tracking_source *source)
+{
+	return container_of(source, struct wmr_controller_base, constellation_tracking_source);
+}
+
+static void
+wmr_controller_base_constellation_get_tracked_pose(struct t_constellation_tracker_tracking_source *source,
+                                                   int64_t when_ns,
+                                                   struct xrt_space_relation *out_relation)
+{
+	struct wmr_controller_base *wcb = wmr_controller_base_from_constellation_tracking_source(source);
+	wmr_controller_base_get_tracked_pose(&wcb->base, XRT_INPUT_GENERIC_GRIP_POSE, when_ns, out_relation);
+}
