+		out_relation->pose.position = optical_relation.pose.position;
+		out_relation->relation_flags = (enum xrt_space_relation_flags)(
+		    out_relation->relation_flags | XRT_SPACE_RELATION_POSITION_VALID_BIT |
+		    XRT_SPACE_RELATION_POSITION_TRACKED_BIT);
+
+		if ((optical_relation.relation_flags & XRT_SPACE_RELATION_LINEAR_VELOCITY_VALID_BIT) != 0) {
+			out_relation->linear_velocity = optical_relation.linear_velocity;
+			out_relation->relation_flags = (enum xrt_space_relation_flags)(
+			    out_relation->relation_flags | XRT_SPACE_RELATION_LINEAR_VELOCITY_VALID_BIT);
+		}
+	}
+
+	if (name == XRT_INPUT_WMR_AIM_POSE || name == XRT_INPUT_G2_CONTROLLER_AIM_POSE ||
+	    name == XRT_INPUT_ODYSSEY_CONTROLLER_AIM_POSE) {
+		const float half_angle = debug_get_float_option_wmr_controller_aim_yaw_degrees() *
+		                         (float)M_PI / 360.0f;
+		const struct xrt_quat offset = {
+		    .x = 0.0f,
+		    .y = sinf(half_angle),
+		    .z = 0.0f,
+		    .w = cosf(half_angle),
+		};
+
+		const struct xrt_quat q = out_relation->pose.orientation;
+
+		out_relation->pose.orientation.x =
+		    q.w * offset.x + q.x * offset.w + q.y * offset.z - q.z * offset.y;
+		out_relation->pose.orientation.y =
+		    q.w * offset.y - q.x * offset.z + q.y * offset.w + q.z * offset.x;
+		out_relation->pose.orientation.z =
+		    q.w * offset.z + q.x * offset.y - q.y * offset.x + q.z * offset.w;
+		out_relation->pose.orientation.w =
+		    q.w * offset.w - q.x * offset.x - q.y * offset.y - q.z * offset.z;
+	}
+
 	return XRT_SUCCESS;
 }
 
