+static void
+wmr_controller_base_push_constellation_tracker_sample(struct t_constellation_tracker_device *device,
+                                                      struct t_constellation_tracker_sample *sample)
+{
+	struct wmr_controller_base *wcb = wmr_controller_base_from_constellation_device(device);
+	wcb->constellation_sample_count++;
+
+	if (wcb->constellation_sample_count == 1 || wcb->constellation_sample_count % 60 == 0) {
+		WMR_INFO(wcb,
+		         "WMR optical controller sample #%" PRIu64
+		         " pose=(%.3f %.3f %.3f) matched=%u visible=%u reprojection=%.3f",
+		         wcb->constellation_sample_count, sample->pose.position.x, sample->pose.position.y,
+		         sample->pose.position.z, sample->metrics.matched_blob_count, sample->metrics.visible_led_count,
+		         sample->metrics.reprojection_error);
+	}
+
+	const uint32_t min_matched = (uint32_t)debug_get_num_option_wmr_controller_min_matched_blobs();
+	const float max_reprojection = debug_get_float_option_wmr_controller_max_reprojection_error();
+	const float max_jump = debug_get_float_option_wmr_controller_max_position_jump();
+	const struct xrt_vec3 sample_position = sample->pose.position;
+
+	bool reject = sample->metrics.matched_blob_count < min_matched ||
+	              sample->metrics.reprojection_error > (double)max_reprojection;
+
+	if (!reject && wcb->has_last_constellation_position && max_jump > 0.0f) {
+		const struct xrt_vec3 delta = {
+		    .x = sample_position.x - wcb->last_constellation_position.x,
+		    .y = sample_position.y - wcb->last_constellation_position.y,
+		    .z = sample_position.z - wcb->last_constellation_position.z,
+		};
+		const float jump = sqrtf(delta.x * delta.x + delta.y * delta.y + delta.z * delta.z);
+		reject = jump > max_jump;
+	}
+
+	if (reject) {
+		wcb->constellation_rejected_sample_count++;
+		if (wcb->constellation_rejected_sample_count == 1 ||
+		    wcb->constellation_rejected_sample_count % 60 == 0) {
+			WMR_INFO(wcb,
+			         "Rejected WMR optical controller sample #%" PRIu64
+			         " matched=%u reprojection=%.3f pos=(%.3f %.3f %.3f)",
+			         wcb->constellation_sample_count, sample->metrics.matched_blob_count,
+			         sample->metrics.reprojection_error, sample_position.x, sample_position.y,
+			         sample_position.z);
+		}
+		return;
+	}
+
+	struct xrt_vec3 filtered_position = sample_position;
+	if (wcb->has_last_constellation_position) {
+		float alpha = debug_get_float_option_wmr_controller_optical_position_alpha();
+		alpha = CLAMP(alpha, 0.0f, 1.0f);
+		filtered_position.x = wcb->last_constellation_position.x +
+		                      (sample_position.x - wcb->last_constellation_position.x) * alpha;
+		filtered_position.y = wcb->last_constellation_position.y +
+		                      (sample_position.y - wcb->last_constellation_position.y) * alpha;
+		filtered_position.z = wcb->last_constellation_position.z +
+		                      (sample_position.z - wcb->last_constellation_position.z) * alpha;
+	}
+
+	wcb->last_constellation_position = filtered_position;
+	wcb->has_last_constellation_position = true;
+
+	struct xrt_space_relation relation = {
+	    .pose.position = filtered_position,
+	    .pose.orientation = XRT_QUAT_IDENTITY,
+	    .relation_flags = XRT_SPACE_RELATION_POSITION_VALID_BIT | XRT_SPACE_RELATION_POSITION_TRACKED_BIT,
+	};
+
+	m_relation_history_push(wcb->constellation_relation_history, &relation, sample->timestamp_ns);
+}
