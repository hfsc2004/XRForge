+bool
+wmr_hmd_register_controller_for_tracking(struct xrt_device *hmd_xdev, struct xrt_device *controller_xdev)
+{
+	struct wmr_hmd *wh = wmr_hmd(hmd_xdev);
+	struct wmr_controller_base *wcb = wmr_controller_base_from_xrt_device(controller_xdev);
+
+	if (wh == NULL || wcb == NULL || wh->tracking.controller_tracker == NULL) {
+		return false;
+	}
+
+	if (wcb->constellation_registered) {
+		return true;
+	}
+
+	if (wcb->config.led_count <= 0) {
+		WMR_WARN(wh, "Cannot register WMR controller for optical tracking: no LED calibration");
+		return false;
+	}
+
+	wcb->constellation_leds = U_TYPED_ARRAY_CALLOC(struct t_constellation_tracker_led, wcb->config.led_count);
+	if (wcb->constellation_leds == NULL) {
+		return false;
+	}
+
+	for (int i = 0; i < wcb->config.led_count; i++) {
+		wcb->constellation_leds[i].position = wcb->config.leds[i].pos;
+		wcb->constellation_leds[i].normal = wcb->config.leds[i].norm;
+		wcb->constellation_leds[i].radius_m = 0.004f;
+		wcb->constellation_leds[i].visibility_angle = 1.57079632679f;
+		wcb->constellation_leds[i].id = (t_constellation_led_id_it)i;
+	}
+
+	struct t_constellation_tracker_device_params params = {
+	    .led_model =
+	        {
+	            .leds = wcb->constellation_leds,
+	            .led_count = (size_t)wcb->config.led_count,
+	            .compute_led_visibility = wmr_controller_led_visible,
+	        },
+	    .tracking_source = &wcb->constellation_tracking_source,
+	};
+
+	int ret = t_constellation_tracker_add_device(wh->tracking.controller_tracker, &params, &wcb->constellation_device,
+	                                             &wcb->constellation_device_id);
+	if (ret != 0) {
+		WMR_WARN(wh, "Failed to register WMR controller for optical tracking");
+		free(wcb->constellation_leds);
+		wcb->constellation_leds = NULL;
+		return false;
+	}
+
+	wcb->constellation_registered = true;
+	wcb->base.tracking_origin = t_constellation_tracker_get_tracking_origin(wh->tracking.controller_tracker);
+	WMR_INFO(wh, "Registered %s with WMR optical controller tracker (%d LEDs)", wcb->base.str,
+	         wcb->config.led_count);
+
+	return true;
+}
