+		const bool too_dark = min_bright_pixels > 0 && above_required < min_bright_pixels;                    \
+		const bool too_bright = (max_bright_pixels > 0 && above_required > max_bright_pixels) ||              \
+		                        bright_fraction > max_bright_fraction;                                        \
 		const bool skip_tracking = too_dark || too_bright;                                                    \
 		if (should_log || may_dump) {                                                                          \
 			if (should_log) {                                                                             \
