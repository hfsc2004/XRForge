+static void
+controller_frame_stats(struct xrt_frame *xf, uint8_t *out_max, uint32_t *out_above_pixel, uint32_t *out_above_required)
+{
+	uint8_t max_pixel = 0;
+	uint32_t above_pixel = 0;
+	uint32_t above_required = 0;
+	const uint8_t pixel_threshold = (uint8_t)debug_get_num_option_wmr_controller_blob_pixel_threshold();
+	const uint8_t required_threshold = (uint8_t)debug_get_num_option_wmr_controller_blob_required_threshold();
+
+	for (uint32_t y = 0; y < xf->height; y++) {
+		const uint8_t *row = xf->data + y * xf->stride;
+		for (uint32_t x = 0; x < xf->width; x++) {
+			const uint8_t px = row[x];
+			max_pixel = MAX(max_pixel, px);
+			if (px > pixel_threshold) {
+				above_pixel++;
+			}
+			if (px >= required_threshold) {
+				above_required++;
+			}
+		}
+	}
+
+	*out_max = max_pixel;
+	*out_above_pixel = above_pixel;
+	*out_above_required = above_required;
+}
+
+static void
+controller_frame_dump(int camera_id, uint64_t frame_count, const struct xrt_frame *xf)
+{
+	char path[128];
+	(void)snprintf(path, sizeof(path), "/tmp/xrforge-wmr-controller-cam%d-%06" PRIu64 ".pgm", camera_id,
+	               frame_count);
+
+	FILE *file = fopen(path, "wb");
+	if (file == NULL) {
+		return;
+	}
+
+	(void)fprintf(file, "P5\n%u %u\n255\n", xf->width, xf->height);
+	for (uint32_t y = 0; y < xf->height; y++) {
+		const uint8_t *row = xf->data + y * xf->stride;
+		(void)fwrite(row, 1, xf->width, file);
+	}
+
+	fclose(file);
+}
 
